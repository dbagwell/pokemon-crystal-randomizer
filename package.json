{
  "name": "pokemon-crystal-randomizer",
  "productName": "Pokemon Crystal Randomizer",
  "version": "0.7.0",
  "description": "Generate and apply patches for Pokémon Crystal Version",
  "author": "David Bagwell",
  "license": "MIT",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "gen:styles": "sass src/sass/global.scss src/renderer/css/global.css",
    "gen:grammars": "nearleyc src/nearley/data.ne -o src/worker/grammars/dataGrammar.mjs",
    "gen:data": "set -a; source .tools.env; set +a; vite-node -c vite.tools.config.ts tools/generateAllData.ts",
    "playground": "set -a; source .tools.env; set +a; vite-node -c vite.tools.config.ts tools/playground.ts",
    "lint": "eslint --fix .",
    "dev": "electron-forge start",
    "build": "electron-forge package --platform darwin --arch arm64; rm -rf out",
    "package:mac": "npm run build && electron-builder -m",
    "package:win": "npm run build && electron-builder -w",
    "package:linux": "npm run build && electron-builder -l",
    "package": "npm run build && electron-builder -mwl"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.7.6",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "dompurify": "^3.4.2",
    "electron": "^45.3.0",
    "electron-affinity": "^1.2.4",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "lz-string": "^1.5.0",
    "material-icons": "^1.13.14",
    "nearley": "^2.20.1",
    "object-hash": "^3.0.0",
    "sass": "^1.99.0",
    "seedrandom": "^3.0.5",
    "source-map-support": "^0.5.21",
    "svelte": "^5.55.5",
    "typescript-eslint": "^8.72.2",
    "vite-node": "^6.0.0",
    "yaml": "^2.8.4"
  }
}